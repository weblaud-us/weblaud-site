# ---------------------------------------------------------------------------
# Template for weblaud-site/.env — copy to .env and fill in.
#
# Two DIFFERENT kinds of variable live in this file. The distinction decides
# when the value has to be present, and getting it wrong fails in two very
# different ways:
#
#   VITE_*  — inlined into the CLIENT bundle at BUILD time. Must be set before
#             `npm run build` runs. Changing it later has no effect until the
#             next build. Never put a secret here: it ships to every browser.
#
#   others  — read from process.env at RUNTIME by the Node server. Must be
#             present in the environment of the PM2/Docker process. The app
#             itself never reads this file: there is no dotenv dependency and
#             react-router-serve does not read .env. ecosystem.config.cjs
#             parses it and hands it to PM2, which is what delivers these.
#
#             So `pm2 restart weblaud-site` picks up an edit here, but a bare
#             `node`/`npm start` or `docker run` does NOT — pass the values in
#             explicitly there. See DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# (There are currently no build-time VITE_* variables. The old
# VITE_CONTACT_FORM_ACCESS_KEY / Web3Forms courtesy email was removed: its key
# shipped in the browser bundle, so spammers could mail the inbox with it
# directly. Delete or regenerate that key in the Web3Forms dashboard.)

# --- Runtime / server-only (NEVER prefix with VITE_) ---

# Cloudflare Turnstile SITE key (public — it is embedded in the page) for the
# bot check on the contact, estimate and job-application forms. Read at
# runtime by the root loader, so changing it needs a restart, not a rebuild.
# The matching SECRET key goes in backend/.env as TURNSTILE_SECRET_KEY.
# Empty = no widget (forms behave as before) — fine for local dev.
TURNSTILE_SITE_KEY=

# Sentry error monitoring — the WEBSITE project's DSN (the backend has its own).
# Public by design, read at runtime (restart, not rebuild). Empty = no Sentry
# code is loaded at all. When set, server errors are reported from
# entry.server.tsx and browser errors from a lazily loaded ~32 kB chunk;
# query strings, cookies, bodies and user details are stripped
# (app/lib/sentry-scrub.ts). The 500 page says "our team has been notified"
# only while this is set.
SENTRY_DSN=
# Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=

# Shared secret proving to the backend that forwarded visitor IP/user-agent
# headers really come from this server. Without it the backend rate-limits
# the whole site as one visitor and records this server's IP on contract
# acceptances. Must be IDENTICAL to INTERNAL_API_SECRET in backend/.env.
# nginx in front of this app must also OVERWRITE X-Real-IP with the real
# client address (with real_ip_header CF-Connecting-IP + Cloudflare's IP ranges
# when behind Cloudflare) — otherwise a visitor could choose their own IP.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
INTERNAL_API_SECRET=

# Backend API root, including the /api/v1 suffix.
# Production is https://api.weblaud.com/api/v1; use http://127.0.0.1:4000/api/v1
# only while running the backend locally on this same host.
# Defaults to http://127.0.0.1:4000/api/v1 when unset. If it is wrong, pages do
# not error: every fetchOptional() call falls back to placeholder content and
# the site looks live but empty. Set it explicitly.
API_BASE_URL=https://api.weblaud.com/api/v1

# Fallback signer for both the __weblaud_admin_session and
# __weblaud_portal_session cookies. REQUIRED unless both of the
# surface-specific secrets below are set — app/lib/session.server.ts and
# app/lib/portal.server.ts each throw at module load if neither their own
# secret nor this one is present, and because that check is bundled at the
# top level of build/server/index.js, the server dies on STARTUP, not on the
# first request. A missing value is a PM2 crash loop, not a 500.
# Rotating it invalidates every signed-in session on whichever surface(s)
# are using it as their secret.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Surface-specific secrets — set BOTH of these (each with its own generated
# value) so a leak of one signing key can't be replayed to forge a session
# on the other surface. Each falls back to SESSION_SECRET above when unset,
# so setting only one is valid but leaves that isolation half-done.
ADMIN_SESSION_SECRET=
PORTAL_SESSION_SECRET=

# Gates the Secure flag on the admin session cookie (session.server.ts) and
# React's production build behaviour. PM2 sets this via ecosystem.config.cjs;
# set it here too so a bare `npm start` or `docker run` cannot ship the admin
# cookie without Secure.
NODE_ENV=production

# Port react-router-serve binds. Must match the nginx upstream.
PORT=3000
